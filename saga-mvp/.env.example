# Copy this file to .env and replace the placeholder with a long random secret.
SEED_ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional attendee addresses shown on Google Calendar events.
ALICE_EMAIL=
BOB_EMAIL=

# Groq Cloud API key for the natural-language meeting assistant (get one at https://console.groq.com/keys).
GROQ_API_KEY=
# Any chat-completions model enabled for your Groq account; this default supports tool calling.
GROQ_MODEL=openai/gpt-oss-20b
